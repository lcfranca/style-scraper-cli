{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://style-scraper.local/schemas/raw-facts.schema.json",
  "title": "style-scraper RawFacts",
  "type": "object",
  "required": ["schema_version", "url", "viewport", "pages"],
  "properties": {
    "schema_version": { "const": "raw-facts.v1" },
    "url": { "type": "string", "format": "uri" },
    "viewport": { "$ref": "#/$defs/viewport" },
    "color_scheme": { "enum": ["light", "dark"] },
    "captured_at": { "type": "string" },
    "runtime": { "const": "bun" },
    "browser": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string" },
        "version": { "type": "string" },
        "user_agent_hash": { "type": "string" }
      },
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/page" }
    },
    "diagnostics": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" },
      "default": []
    }
  },
  "additionalProperties": false,
  "$defs": {
    "viewport": {
      "type": "object",
      "required": ["width", "height", "device_scale_factor"],
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "device_scale_factor": { "type": "number", "exclusiveMinimum": 0 }
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": ["url", "title", "dom", "cssom", "layout", "accessibility"],
      "properties": {
        "url": { "type": "string" },
        "title": { "type": "string" },
        "dom": {
          "type": "object",
          "required": ["nodes"],
          "properties": {
            "nodes": {
              "type": "array",
              "items": { "$ref": "#/$defs/domNode" }
            }
          },
          "additionalProperties": false
        },
        "cssom": {
          "type": "object",
          "required": ["computed_styles"],
          "properties": {
            "computed_styles": {
              "type": "array",
              "items": { "$ref": "#/$defs/computedStyle" }
            }
          },
          "additionalProperties": false
        },
        "layout": {
          "type": "object",
          "required": ["boxes"],
          "properties": {
            "boxes": {
              "type": "array",
              "items": { "$ref": "#/$defs/layoutBox" }
            }
          },
          "additionalProperties": false
        },
        "accessibility": {
          "type": "object",
          "required": ["nodes"],
          "properties": {
            "nodes": {
              "type": "array",
              "items": { "$ref": "#/$defs/accessibilityNode" }
            },
            "tree": {}
          },
          "additionalProperties": false
        },
        "state_deltas": {
          "type": "array",
          "items": { "$ref": "#/$defs/stateDelta" },
          "default": []
        },
        "screenshots": {
          "type": "array",
          "items": { "$ref": "#/$defs/screenshot" },
          "default": []
        }
      },
      "additionalProperties": false
    },
    "domNode": {
      "type": "object",
      "required": ["id", "tag", "attributes", "text_length", "visible", "child_index"],
      "properties": {
        "id": { "type": "string" },
        "parent_id": { "type": ["string", "null"] },
        "tag": { "type": "string" },
        "attributes": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        },
        "text_hash": { "type": "string" },
        "text_value": { "type": "string" },
        "text_length": { "type": "integer", "minimum": 0 },
        "visible": { "type": "boolean" },
        "child_index": { "type": "integer", "minimum": 0 }
      },
      "additionalProperties": false
    },
    "computedStyle": {
      "type": "object",
      "required": ["node_id"],
      "properties": {
        "id": { "type": "string" },
        "node_id": { "type": "string" },
        "display": { "type": "string" },
        "position": { "type": "string" },
        "color": { "type": "string" },
        "background_color": { "type": "string" },
        "font_family": { "type": "string" },
        "font_size": { "type": "string" },
        "font_weight": { "type": "string" },
        "line_height": { "type": "string" },
        "letter_spacing": { "type": "string" },
        "padding": { "type": "string" },
        "margin": { "type": "string" },
        "gap": { "type": "string" },
        "row_gap": { "type": "string" },
        "column_gap": { "type": "string" },
        "border_radius": { "type": "string" },
        "border_width": { "type": "string" },
        "border_style": { "type": "string" },
        "border_color": { "type": "string" },
        "box_shadow": { "type": "string" },
        "opacity": { "type": "string" },
        "z_index": { "type": "string" },
        "transition_duration": { "type": "string" },
        "transition_timing_function": { "type": "string" },
        "animation_duration": { "type": "string" },
        "transform": { "type": "string" }
      },
      "additionalProperties": false
    },
    "layoutBox": {
      "type": "object",
      "required": ["id", "node_id", "x", "y", "width", "height", "visible"],
      "properties": {
        "id": { "type": "string" },
        "node_id": { "type": "string" },
        "x": { "type": "number" },
        "y": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "z_index": { "type": "integer" },
        "visible": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "accessibilityNode": {
      "type": "object",
      "required": ["id", "role"],
      "properties": {
        "id": { "type": "string" },
        "node_id": { "type": "string" },
        "role": { "type": "string" },
        "name_hash": { "type": "string" },
        "disabled": { "type": "boolean" },
        "focused": { "type": "boolean" },
        "checked": { "type": "boolean" },
        "expanded": { "type": "boolean" },
        "selected": { "type": "boolean" },
        "heading_level": { "type": "integer", "minimum": 1, "maximum": 6 }
      },
      "additionalProperties": false
    },
    "stateDelta": {
      "type": "object",
      "required": ["state", "changed_properties", "safe_interaction"],
      "properties": {
        "state": { "type": "string" },
        "target_node_id": { "type": "string" },
        "target_signature": { "type": "string" },
        "changed_properties": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["before", "after"],
            "properties": {
              "before": { "type": "string" },
              "after": { "type": "string" }
            },
            "additionalProperties": false
          }
        },
        "safe_interaction": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "screenshot": {
      "type": "object",
      "required": ["id", "screenshot_type", "sha256", "viewport"],
      "properties": {
        "id": { "type": "string" },
        "screenshot_type": { "type": "string" },
        "path": { "type": "string" },
        "sha256": { "type": "string" },
        "viewport": { "$ref": "#/$defs/viewport" }
      },
      "additionalProperties": false
    },
    "diagnostic": {
      "type": "object",
      "required": ["code", "message", "phase", "severity"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "phase": { "type": "string" },
        "severity": { "type": "string" }
      },
      "additionalProperties": false
    }
  }
}
