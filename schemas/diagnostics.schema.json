{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://style-scraper.local/schemas/diagnostics.schema.json",
  "title": "style-scraper diagnostics",
  "type": "object",
  "required": ["warnings", "unsupported", "confidence_summary"],
  "properties": {
    "warnings": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "unsupported": {
      "type": "array",
      "items": { "$ref": "#/$defs/diagnostic" }
    },
    "confidence_summary": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "$defs": {
    "diagnostic": {
      "type": "object",
      "required": ["code", "message", "phase", "severity"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" },
        "phase": { "type": "string" },
        "severity": {
          "type": "string",
          "enum": ["info", "warning", "error"]
        },
        "recoverable": { "type": "boolean" },
        "recommended_action": { "type": "string" },
        "timings": { "type": "object" },
        "completed": { "type": "object" },
        "http_status": { "type": "integer" },
        "retry_after": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
